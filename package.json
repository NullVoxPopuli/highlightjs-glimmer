{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "author": "NullVoxPopuli",
  "license": "MIT",
  "files": [],
  "scripts": {
    "release": "changeset publish",
    "prepare": "pnpm build",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "debug": "npx html-pages . --no-cache",
    "lint:fix": "concurrently 'npm:lint:*:fix' --names 'fix:' && pnpm --filter '*' lint:fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write ."
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@nullvoxpopuli/eslint-configs": "^6.0.0",
    "concurrently": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-html": "^8.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "ember-cli-htmlbars"
      ]
    }
  },
  "engines": {
    "node": ">= 18"
  },
  "volta": {
    "node": "24.19.0",
    "yarn": "1.22.22",
    "npm": "12.0.2"
  }
}
